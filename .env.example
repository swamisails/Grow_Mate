# GrowMate stack configuration (AD-17). Copy to `.env` at the repo root and fill in.
# Docker Compose reads this file; the containers get configuration only from these variables.
# Never commit the real `.env`.

# Environment: local | e2e | production
APP_ENV=local
# Laravel encryption key. Generate one with:
#   docker run --rm php:8.5-cli php -r 'echo "base64:".base64_encode(random_bytes(32)).PHP_EOL;'
APP_KEY=
# Public URL of the single origin served by `web` (AD-1).
APP_URL=http://localhost:8180

# MySQL database the `api` uses, created by the `mysql` service on first start.
DB_DATABASE=growmate
DB_USERNAME=growmate
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Sanctum SPA cookie sessions (AD-9): the host:port the browser uses, and the session cookie domain.
SANCTUM_STATEFUL_DOMAINS=localhost:8180
SESSION_DOMAIN=localhost

# The one Admin, seeded idempotently in every environment.
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Host port for `web` (default 8180). Keep APP_URL and SANCTUM_STATEFUL_DOMAINS in step.
# MySQL is never published to the host; it is reachable only on the Compose network.
WEB_PORT=8180
